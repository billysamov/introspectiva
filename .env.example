# Canonical public site URL (used for metadata and accepted form origins).
NEXT_PUBLIC_SITE_URL=https://introspectiva.digital

# Server-only. Never use a NEXT_PUBLIC_ prefix for these variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Optional fallback for an existing project using legacy JWT keys:
# SUPABASE_SERVICE_ROLE_KEY=

# Random secret, at least 32 characters, stable across all deployments.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SECRET=
